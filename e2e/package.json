{
    "private": true,
    "name": "superdesk",
    "license": "GPL-3.0",
    "dependencies": {
        "node-polyfill-webpack-plugin": "^4.1.0",
        "superdesk-core": "github:superdesk/superdesk-client-core#develop",
        "superdesk-planning": "file:../"
    },
    "devDependencies": {
        "@playwright/test": "~1.58.2",
        "@superdesk/build-tools": "^1.0.14",
        "http-server": "14.1.1",
        "lodash": "^4.17.15",
        "moment": "^2.29.4",
        "moment-timezone": "^0.5.47",
        "superdesk-code-style": "1.3.0",
        "typescript": "^5.8.3"
    },
    "scripts": {
        "build": "SUPERDESK_URL=http://localhost:5050/api npx @superdesk/build-tools build-root-repo ./",
        "check-types": "tsc --noEmit --resolveJsonModule",
        "e2e:setup": "bash scripts/setup.sh",
        "e2e": "docker compose up -d --wait && npx playwright test; EXIT=$?; docker compose down; exit $EXIT",
        "e2e:ui": "docker compose up -d --wait && npx playwright test --ui",
        "e2e:services:up": "docker compose up -d --wait",
        "e2e:services:down": "docker compose down",
        "playwright": "playwright test",
        "playwright-interactive": "playwright test --ui"
    },
    "volta": {
        "node": "22.22.0"
    }
}
