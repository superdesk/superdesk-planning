{
    "private": true,
    "name": "superdesk",
    "license": "GPL-3.0",
    "dependencies": {
        "superdesk-core": "github:superdesk/superdesk-client-core#develop",
        "superdesk-planning": "file:../"
    },
    "devDependencies": {
        "@superdesk/build-tools": "^1.0.14",
        "superdesk-code-style": "1.3.0",
        "cypress": "^13.16.1",
        "cypress-real-events": "^1.14.0",
        "cypress-terminal-report": "^5.0.2",
        "lodash": "^4.17.15",
        "moment": "^2.29.4",
        "moment-timezone": "^0.5.47",
        "@playwright/test": "~1.47.0",
        "http-server": "14.1.1",
        "typescript": "^5.8.3"
    },
    "scripts": {
        "cypress-ui": "TZ=Australia/Sydney cypress open",
        "cypress-ci": "TZ=Australia/Sydney cypress run --browser chrome",
        "clean": "grunt clean",
        "build": "npx @superdesk/build-tools build-root-repo ./",
        "serve": "node --max-old-space-size=8192 ./node_modules/.bin/grunt server",
        "start": "grunt server",
        "check-types": "tsc --noEmit --resolveJsonModule",
        "playwright": "playwright test --workers 1",
        "playwright-interactive": "playwright test --ui",
        "start-client-server": "http-server dist -p 9000 -s &",
        "stop-client-server": "fuser -k 9000/tcp",
        "start-test-server": "cd ../server && docker-compose build && docker-compose up -d",
        "stop-test-server": "cd ../server && docker-compose stop"
    },
    "volta": {
        "node": "14.21.3"
    }
}
